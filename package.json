{
	"name": "obsidian-mermaid-fullscreen",
	"version": "1.0.0",
	"description": "Obsidian plugin: fullscreen button for Mermaid diagrams with native theme rendering, zoom and pan.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
